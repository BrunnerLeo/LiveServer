{
  "version": "dli-00.01.16",
  "school": {
    "name": "Digital Lerning Initiativ",
    "logo": ""
  },
  "theme": {
    "primary": "#4b5563",
    "secondary": "#7c8591",
    "accent": "#2563eb",
    "background": "#f4f5f7",
    "surface": "#ffffff",
    "text": "#111827"
  },
  "texts": {
    "loginHint": "Melde dich an und arbeite dort weiter, wo dein letztes Projekt aufgehört hat.",
    "signupHint": "Lege dein Konto an und sichere dir einen eigenen Bereich für Code, Dateien und Abgaben.",
    "publicIntro": "Der zentrale Ort für digitale Unterrichtsprojekte: Dateien organisieren, Webseiten live testen und Ergebnisse sicher freigeben."
  },
  "registration": {
    "enabled": true,
    "message": "Registrierung ist für neue Schülerkonten aktiviert."
  },
  "security": {
    "sessionName": "LIVESERVER_SESSION",
    "secureCookie": true,
    "sameSite": "Strict",
    "showDetailedErrors": false
  },
  "database": {
    "driver": "sqlite",
    "sqlitePath": "{PROJECT_ROOT}/database/liveserver.sqlite",
    "passwordAlgorithm": "argon2id"
  },
  "projects": {
    "uploadPath": "{PROJECT_ROOT}/uploads/projects",
    "maxUploadBytes": 41943040
  },
  "ai": {
    "maxContextChars": 24000,
    "maxPromptChars": 2000,
    "models": {
      "selfhosted": [
        "aris",
        "jenny",
        "em-german-mistral",
        "leolm-1.1b-german",
        "qwen2.5-coder",
        "llama3.1",
        "codellama"
      ]
    },
    "aiSmall": {
      "baseUrl": "http://localhost:8080/v1",
      "maxConcurrent": 1,
      "highPriorityWaitSeconds": 180,
      "lowPriorityWaitSeconds": 0
    },
    "localCoder": {
      "enabled": false,
      "baseUrl": "http://localhost:8080/v1",
      "model": "aris",
      "apiKey": ""
    },
    "jenny": {
      "enabled": false,
      "baseUrl": "http://localhost:8080/v1",
      "model": "jenny",
      "apiKey": "",
      "maxPromptChars": 4000,
      "maxTextChars": 12000,
      "onlyWhenCapacity": true
    },
    "selfHostedAllowedBaseUrls": [
      "http://localhost:8080/v1",
      "http://127.0.0.1:8080/v1",
      "http://localhost:11434/v1",
      "http://127.0.0.1:11434/v1"
    ]
  },
  "runtimes": {
    "enabled": true,
    "workspacePath": "{PROJECT_ROOT}/runtime/jobs",
    "timeoutSeconds": 5,
    "maxInputBytes": 16384,
    "maxOutputBytes": 65536,
    "maxSourceBytes": 1048576,
    "maxMemoryKb": 524288,
    "maxTasks": 128,
    "javaMaxHeapMb": 96,
    "javaMaxMemoryKb": 2097152,
    "sandboxEnabled": true,
    "bubblewrapBinary": "bwrap",
    "sandboxReadonlyPaths": [
      "/usr",
      "/bin",
      "/lib",
      "/lib64",
      "/etc/alternatives",
      "/etc/java-17-openjdk",
      "/etc/java-21-openjdk"
    ],
    "javaCompiler": "javac",
    "javaBinary": "java",
    "cCompiler": "gcc",
    "timeoutBinary": "timeout"
  },
  "smb": {
    "enabled": false,
    "workspacePath": "{PROJECT_ROOT}/smb/projects",
    "autoImport": false,
    "autoExport": false,
    "userProvisioning": false,
    "provisionHelperPath": "",
    "aclHelperPath": ""
  },
  "studentContent": {
    "default": [
      {
        "id": "vertretungsplan",
        "title": "Vertretungsplan",
        "description": "Allgemeine Informationen zum aktuellen Schultag.",
        "type": "Allgemein",
        "url": "#"
      },
      {
        "id": "schulordnung",
        "title": "Schulordnung",
        "description": "Wichtige Regeln und Hinweise für den Schulalltag.",
        "type": "Dokument",
        "url": "#"
      }
    ],
    "byUserId": {
      "1": [
        {
          "id": "mathematik-klasse",
          "title": "Mathematik Aufgabenpaket",
          "description": "Persönlich freigegebenes Aufgabenpaket für diese Benutzer-ID.",
          "type": "Aufgabe",
          "url": "#"
        }
      ]
    },
    "byUsername": {
      "max.mustermann": [
        {
          "id": "projektmappe",
          "title": "Projektmappe",
          "description": "Zusätzliche Freigabe nur für diesen Benutzernamen.",
          "type": "Projekt",
          "url": "#"
        }
      ]
    }
  }
}
